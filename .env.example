# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
APP_BASE_URL=http://localhost:8000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://swb_app:changeme@localhost:5432/studentwellbeing

# --- DeepSeek (AI agents) ---
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
AGENT_MODEL=deepseek-chat
AGENT_MAX_TOKENS=8192

# --- JWT session auth ---
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- Risk pre-screening thresholds ---
MODERATE_RISK_THRESHOLD=40
HIGH_RISK_THRESHOLD=70

# --- Multi-lingual ---
DEFAULT_LANGUAGE_CODE=ms

# --- SMTP (password reset emails) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Student Well-Being — KPM
